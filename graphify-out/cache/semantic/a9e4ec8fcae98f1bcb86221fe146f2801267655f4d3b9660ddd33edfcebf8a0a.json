{"nodes": [{"id": "quip_design_doc", "label": "Design Decisions Document", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quip_design_zero_deps", "label": "Zero External Dependencies", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stripped binary ~39K, startup ~2ms. Every feature hand-rolled in C \u2014 no libreadline, no libffi, no JSON library. Adding a dependency must justify the bloat."}, {"id": "quip_design_custom_editor", "label": "Custom Line Editor vs libreadline", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than pull in readline (~200K, GPL), quip has a ~120-line editor in prompt.c. Lacks kill-ring, vi-mode, multi-byte \u2014 acceptable for a personal shell."}, {"id": "quip_design_lazy_daemon", "label": "Lazy Python Daemon", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daemon forks on first plugin use, not shell startup. Shell starts in ~2ms regardless of plugin count. First plugin call pays ~100ms penalty."}, {"id": "quip_design_abstractsocket", "label": "Abstract Unix Socket for Plugin IPC", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linux abstract socket avoids filesystem entry (no stale socket cleanup) and needs no special permissions. Downside: Linux-only; macOS/FreeBSD would need path-based socket."}, {"id": "quip_design_forkexec", "label": "Fork-Exec Model for External Commands", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fork() + execvp() gives direct control over signal dispositions and fd manipulation in the child, critical for pipeline plumbing and redirection. Heavier than posix_spawn() on some kernels."}, {"id": "quip_design_builtin_redir", "label": "Builtin Redirection via fd Save-Restore", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builtins/plugins run in the shell process, so redirection must be applied then undone: fflush \u2192 dup() \u2192 dup2() \u2192 execute \u2192 fflush \u2192 dup2() back. Avoids spawning a process for echo > file."}, {"id": "quip_design_multiline", "label": "Multiline via Backslash and Quote Tracking", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enter checks odd backslash count and odd double-quote count for continuation. Simpler than a full parser state machine (heredocs, $() nesting) but covers common interactive cases."}, {"id": "quip_design_nojobctrl", "label": "No Job Control Signals (SIGTSTP Ignored)", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIGTSTP (Ctrl-Z) ignored. Backgrounding via & syntax and bg/fg builtins only. Avoids terminal process-group complexity; Ctrl-Z does nothing (tradeoff)."}], "edges": [{"source": "quip_design_doc", "target": "quip_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": 13, "weight": 1.0}, {"source": "quip_design_doc", "target": "quip_plugin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md